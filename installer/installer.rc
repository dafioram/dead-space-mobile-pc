// Explicit payloads prepared in a fresh directory by tools/build_installer.py.
PAYLOAD_EXE RCDATA "payload/deadspace.exe"
PAYLOAD_NOTICES RCDATA "payload/THIRD_PARTY_NOTICES.txt"
PAYLOAD_INFO RCDATA "payload/BUILD_INFO.txt"

#ifndef APP_VERSION_TEXT
#define APP_VERSION_TEXT "1.0.0"
#endif
#ifndef APP_VERSION_NUMERIC
#define APP_VERSION_NUMERIC 1,0,0,0
#endif

1 VERSIONINFO
FILEVERSION APP_VERSION_NUMERIC
PRODUCTVERSION APP_VERSION_NUMERIC
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Dead Space Mobile PC Port - Setup"
            VALUE "ProductName", "Dead Space Mobile PC Port"
            VALUE "FileVersion", APP_VERSION_TEXT
            VALUE "ProductVersion", APP_VERSION_TEXT
            VALUE "Comments", "Fan project. Contains no game data: the user supplies their own APK."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

1 24 "installer.manifest"
